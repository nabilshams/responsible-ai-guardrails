{
  "python.testing.pytestArgs": [
    "tests"
  ],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "files.exclude": {
    "**/__pycache__": true
  },
  "chat.tools.terminal.autoApprove": {
    "ConvertFrom-Json": true,
    "Out-Null": true,
    "git check-ignore": true,
    "&": true,
    "az": true,
    ".\\.venv\\Scripts\\python.exe": true,
    "/^az containerapp show --name ca-redaction-chat-raiprivate-xey --resource-group rg-rai-private --query \"\\{state:properties\\.provisioningState,revision:properties\\.latestReadyRevisionName,image:properties\\.template\\.containers\\[0\\]\\.image\\}\" --output json$/": {
      "approve": true,
      "matchCommandLine": true
    }
  }
}
