# Local mode is safe for offline development. Use hybrid in Azure.
PII_BACKEND=local
PII_CONFIDENCE_THRESHOLD=0.70
PII_REPLACEMENT_STYLE=token
PII_DEFAULT_LANGUAGE=en
PII_MAX_UPLOAD_BYTES=10485760
PII_ALLOWED_ORIGINS=[]

# Azure endpoints use DefaultAzureCredential; never place keys here.
AZURE_AI_LANGUAGE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=
FOUNDRY_PROJECT_ENDPOINT=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# JSON array of {"name", "pattern", "replacement"}; patterns are validated.
PII_CUSTOM_PATTERNS=[]
