FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY . .
RUN pip install --no-cache-dir . \
    && useradd --create-home --uid 10001 webapp \
    && chown -R webapp:webapp /app

USER webapp
EXPOSE 8000

CMD ["uvicorn", "scripts.redaction_chat_app:app", "--host", "0.0.0.0", "--port", "8000"]